[test]
category = "terminal"
description = "Terminal counter renders into the headless grid"

[output]
match = "contains"
text = "0"

[[sequence]]
description = "Canvas includes counter value"
actions = [["assert_canvas_contains", "0"]]
expect = "0"

[[sequence]]
description = "Canvas includes counter button"
actions = [["assert_canvas_contains", "+"]]
expect = "+"

[[sequence]]
description = "Semantic node for terminal canvas exists"
actions = [["assert_node_exists", "counter.canvas"]]
expect = "0"
